# ===== SHOPIFY =====
# Dominio de la tienda (sin https://)
SHOPIFY_STORE_DOMAIN=ieyoficial.myshopify.com
# Auth modelo Dev Dashboard 2026: la app NO da un token estatico. Se obtiene un
# access_token (24h) intercambiando estas credenciales por client_credentials.
# Salen del Dev Dashboard de la app -> seccion "Credenciales".
# Scopes requeridos en la version ACTIVA de la app (y aprobar al instalarla):
#   read_products, read_inventory, write_inventory  (write_inventory implica read_inventory)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Version de la Admin API. Desde 2026-04 el input de inventorySetQuantities usa
# `changeFromQuantity`; `compareQuantity` fue eliminado. No bajar de 2026-04 sin
# revertir src/shopify.js (construirInputSet).
SHOPIFY_API_VERSION=2026-04
# Location de Shopify "IEY Shopping Dot Baires" (formato GID completo)
SHOPIFY_DOT_LOCATION_ID=gid://shopify/Location/83342655574

# ===== CONTABILIUM =====
# Base URL de la API REST de Contabilium (mismo valor que usa Prediktia)
CONTABILIUM_API_URL=
# Credenciales OAuth2 client_credentials (copiar del .env de Prediktia)
CONTABILIUM_CLIENT_ID=
CONTABILIUM_CLIENT_SECRET=
# ID del deposito DOT Baires en Contabilium (NO es secreto)
CONTABILIUM_DOT_DEPOSITO_ID=127356

# ===== CONTROL =====
# true = modo simulacion (NO escribe en Shopify). Empezar SIEMPRE en true.
DRY_RUN=true
